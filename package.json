{
  "name": "@local/dsh-agents-guard",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check lib/core.mjs && node --check lib/index.mjs",
    "test": "node test/core.test.mjs"
